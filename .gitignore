!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Project-specific
.superpowers/
dev.db
dev.db-*
*.log
# drizzle/meta — this directory IS source code (migration metadata),
# not generated noise. CI fails without _journal.json + the snapshot.
# Migrations regenerate the meta dir when schema changes via `npm run
# db:generate` — commit those alongside the .sql output.

# Playwright MCP scratch — accessibility snapshots dropped here during
# UI audits. Per-session noise, never source.
.playwright-mcp/
# Ad-hoc screenshots dropped at the repo root during UI audits/sessions —
# kept on disk for reference, never tracked. (Subsumes the old
# /wagon-audit-*.png rule; no production PNG lives at repo root.)
/*.png

# Source 3D models for the render pipeline — canonical on-disk location
# (see hoosiertrail-render-pipeline skill), but 8–36 MB binaries stay out
# of git. covered-wagon-labels.json next to them stays tracked.
tools/blender/models/*.glb

# Python bytecode from blender tooling
__pycache__/

# wagon-bg pipeline scratch
# 2.5GB of LoRA training data — produced once, lives outside git
tools/wagon-bg/lora-train/
# Experimental LoRA-suffix outputs from generate.py's --lora override flag.
# Production tiles live at static/wagon-bg/<layer>-<terrain>[-<variant>].webp
# (no suffix). Already-tracked --v2_2000@1.0 files are 4-layer-era artifacts
# that git won't re-ignore even though they match this pattern.
static/wagon-bg/*--cottagecore@*.webp
static/wagon-bg/*--ht_*@*.webp
static/wagon-bg/*--v2_*@*.webp

# Claude Code per-user / runtime state — NOT shared across machines or users.
# settings.local.json holds per-host permission overrides; scheduled_tasks.lock
# is a runtime singleton owned by the local CC daemon.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# In-copyright Archive.org CDL book excerpts — LOCAL RESEARCH ONLY, never commit.
# Primary copies live untracked in the hoosierTrail-research workspace; backup
# at ~/datasets/ot-revisited/cdl-excerpts-backup-2026-07-02/. These rules were
# previously only in that workspace's local .gitignore — root-level since 2026-07-02.
docs/historical-pass/sources/bruff_excerpts/
docs/historical-pass/sources/mattes_excerpts/
docs/historical-pass/sources/gowans_excerpts/
docs/historical-pass/sources/jablow_excerpts/
docs/historical-pass/sources/ruby_cayuse_excerpts/
docs/historical-pass/sources/_borrowed_book_excerpts/
