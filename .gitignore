# Project-specific
.superpowers/
dev.db
dev.db-*
*.log
# drizzle/meta — this directory IS source code (migration metadata),
# not generated noise. CI fails without _journal.json + the snapshot.
# Migrations regenerate the meta dir when schema changes via `npm run
# db:generate` — commit those alongside the .sql output.

# Playwright MCP scratch — accessibility snapshots dropped here during
# UI audits. Per-session noise, never source.
.playwright-mcp/
# Ad-hoc screenshot files dropped at the repo root by `mcp__playwright`
# screenshot calls during audits.
/wagon-audit-*.png

# wagon-bg pipeline scratch
# 2.5GB of LoRA training data — produced once, lives outside git
tools/wagon-bg/lora-train/
# Experimental LoRA-suffix outputs from generate.py's --lora override flag.
# Production tiles live at static/wagon-bg/<layer>-<terrain>[-<variant>].webp
# (no suffix). Already-tracked --v2_2000@1.0 files are 4-layer-era artifacts
# that git won't re-ignore even though they match this pattern.
static/wagon-bg/*--cottagecore@*.webp
static/wagon-bg/*--ht_*@*.webp
static/wagon-bg/*--v2_*@*.webp

# In-copyright Archive.org CDL book excerpts — LOCAL RESEARCH ONLY, gitignored.
# Volume exceeds fair-use for redistribution; lives on dev machine for grep.
docs/historical-pass/sources/bruff_excerpts/
docs/historical-pass/sources/mattes_excerpts/
docs/historical-pass/sources/gowans_excerpts/
docs/historical-pass/sources/_borrowed_book_excerpts/

# Blender source 3D models — large binaries, render pipeline source not repo content
tools/blender/models/*.glb
tools/blender/models/*.fbx
tools/blender/scratch/
tools/wagon-bg/wagon-refs/*.png

# Generated FLUX/Blender raster outputs that are too large for git
static/wagon-bg/wagon-blender/*--fresh.png
static/wagon-bg/wagon-blender/*--stylized.png
static/wagon-bg/wagon-tex-flux/
static/wagon-bg/wagon-wheels/front--prairie-schooner.png
static/wagon-bg/ground_strip-trail-raw.png
